{
  "name": "er-cli",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.14 -o g2-claude-0.1.3.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "bridge": "node bridge/server.mjs",
    "typecheck": "tsc --noEmit",
    "check:evidence": "node scripts/check-evidence.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.14",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^8.2.2"
  },
  "description": "G2 Claude companion app and local Claude Code bridge for Even Realities G2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
